#!/bin/sh
# One command for the workbench, the same on every laptop:
#   sh kb check     the health check (boot cost, links, staleness, secrets)
#   sh kb report    your score out of seven drawers
#   sh kb brief     the short version Claude Code prints at session start
#   sh kb doctor    what this laptop has, and the exact fix for anything missing
#   sh kb test      the hook tests, plus Python-vs-Perl parity where both exist
# Runs on Python if this laptop has it, otherwise on Perl (which comes with git). Nothing to install.
# Windows: run it in Git Bash, or inside Claude Code as  ! sh kb check
cd "$(dirname "$0")" || exit 1
RUN="sh 3-toolbox/project-kit/.claude/hooks/py"

case "${1:-check}" in
  check)  $RUN 0-meta/scripts/kb_check.py ;;
  report) $RUN 0-meta/scripts/kb_check.py --report ;;
  brief)  $RUN 0-meta/scripts/kb_check.py --brief ;;
  test)   sh 0-meta/scripts/test-hooks.sh || exit 1
          # The parity tests compare each Python script with its Perl twin, so they need both.
          if command -v python3 >/dev/null 2>&1 && python3 -c 'import sys; sys.exit(sys.version_info < (3, 8))' 2>/dev/null \
             && command -v perl >/dev/null 2>&1; then
            sh 0-meta/scripts/test-kb-check.sh && sh 0-meta/scripts/test-golden.sh
          else echo "(twin parity tests skipped: they need both python3 and perl)"; fi ;;
  doctor)
    os=$(uname -s 2>/dev/null)
    case $os in MINGW*|MSYS*|CYGWIN*) os=Windows ;; Darwin) os=macOS ;; *) os=Linux ;; esac
    ok() { printf '  \342\234\223 %s\n' "$*"; }
    no() { printf '  \342\234\227 %s\n' "$*"; bad=1; }
    opt() { printf '  \302\267 %s\n' "$*"; }
    bad=0
    echo "This laptop ($os):"
    if command -v git >/dev/null 2>&1; then ok "$(git --version)"; else
      case $os in Windows) no "git: install Git for Windows (https://git-scm.com/download/win, per-user install works). It also gives Claude Code its Git Bash." ;;
        macOS) no "git: run  xcode-select --install" ;; *) no "git: sudo apt install git  (or your distro's package)" ;; esac; fi
    py=""
    for p in python3 python; do
      if command -v $p >/dev/null 2>&1 && ! { [ "$os" = macOS ] && [ "$(command -v $p)" = /usr/bin/python3 ] && ! xcode-select -p >/dev/null 2>&1; } \
         && $p -c "import sys; sys.exit(sys.version_info < (3, 8))" >/dev/null 2>&1 </dev/null; then py="$p $($p -c 'import platform; print(platform.python_version())')"; break; fi
    done
    [ -z "$py" ] && command -v py >/dev/null 2>&1 && py -3 -c "import sys; sys.exit(sys.version_info < (3, 8))" >/dev/null 2>&1 </dev/null && py="py -3"
    if command -v perl >/dev/null 2>&1 && perl -MJSON::PP -e1 2>/dev/null; then perl_ok=1; else perl_ok=0; fi
    if [ -n "$py" ]; then ok "Python: $py (the hooks run on it)"; else opt "Python: not found. Fine: the hooks and the check run on Perl instead."; fi
    if [ $perl_ok = 1 ]; then ok "Perl with JSON (the fallback for hooks and the check)"; elif [ -z "$py" ]; then
      no "Neither Python nor Perl: the guards cannot run. Install Git (it brings Perl), or Python 3."; else opt "Perl: not found (not needed, you have Python)"; fi
    if command -v claude >/dev/null 2>&1; then
      v=$(claude --version 2>/dev/null | sed 's/ .*//'); ok "Claude Code $v"
    else no "Claude Code: https://code.claude.com/docs/en/setup"; fi
    if [ "$os" = Windows ]; then ok "Git Bash (you are in it): Claude Code runs the hooks here"; fi
    if command -v gh >/dev/null 2>&1; then ok "gh $(gh --version 2>/dev/null | sed -n 1p | sed 's/gh version //; s/ .*//')"; else
      opt "gh: not needed. Use the web button \"Use this template\", then git clone your new repo."; fi
    echo "For the afternoon (Bogdan's bot):"
    for t in jq uv; do if command -v $t >/dev/null 2>&1; then ok "$t"; else
      case "$os:$t" in
        Windows:jq) opt "jq: winget install jqlang.jq   (per-user)";; Windows:uv) opt "uv: powershell -c \"irm https://astral.sh/uv/install.ps1 | iex\"   (per-user, no admin)";;
        macOS:jq) opt "jq: brew install jq  (macOS 15+ may already have /usr/bin/jq)";; macOS:uv) opt "uv: curl -LsSf https://astral.sh/uv/install.sh | sh   (per-user)";;
        *:jq) opt "jq: sudo apt install jq";; *) opt "uv: curl -LsSf https://astral.sh/uv/install.sh | sh   (per-user)";;
      esac; fi; done
    [ $bad = 0 ] && echo "Ready for the morning." || echo "Fix the ✗ lines first."
    exit $bad ;;
  *) echo "usage: sh kb [check|report|brief|doctor|test]" >&2; exit 2 ;;
esac
