{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "sandbox": {
    "enabled": true,
    "failIfUnavailable": true,
    "allowUnsandboxedCommands": false,
    "network": {
      "allowedDomains": [
        "registry.npmjs.org",
        "pypi.org",
        "files.pythonhosted.org",
        "api.nuget.org"
      ]
    },
    "filesystem": {
      "denyRead": ["~/.ssh", "~/.aws", "~/.azure", "~/.kube", "~/.docker/config.json"]
    }
  }
}
