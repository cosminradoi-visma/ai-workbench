# w3-reception-kit · owner config. Copy to owner.env and edit (setup.sh does both for the workshop).
# Sourced by sh (watch.sh, work.sh) and read by the hooks. Relative paths are relative to this file.
# Windows line endings (CRLF) are fine: the scripts strip them.

# Who you are. Only YOUR reaction wakes your agent; anyone can stop it.
OWNER_ID=U00000000                 # your Slack member ID: find-self-dm.sh fills it
OWNER_NAME=                        # setup.sh fills it from `git config user.name`
SIGNATURE=                         # every post starts with this. setup.sh: "🤖 <name>'s agent:"

# The workshop setup: your bot lives in your DM with yourself. Run ./find-self-dm.sh once: it fills in
# OWNER_ID and CHANNEL_ID and sets SELF_DM=true. In self-DM mode only your own messages count.
# Team-channel mode (SOURCE=slack, SELF_DM=false) never gets your workbench, and is not part of the lab.
SELF_DM=false
USE_WORKBENCH=true                 # the script hands the bot your drawers (self-DM and the inbox lane), size-capped
WORKBENCH_DIR=~/workbench          # the workbench from part 1. The bot itself can never read it (bot-settings.json)
WORK_ITEM=                         # optional: also add 2-work/<item>/state.md

MCP_DENY=                          # your other connectors: find-self-dm.sh fills this so the bot loads only Slack

# Where it listens.
SOURCE=inbox                       # slack | inbox. inbox = drop a .md file into inbox/, no Slack needed
CHANNEL_ID=C00000000               # your self-DM (D...): find-self-dm.sh fills it
CHANNEL_NAME=w3-workshop           # only slack-check.sh (the roll call) uses it
TRIGGER=robot_face                 # your reaction that starts the agent (slack: hasmy::robot_face:)
MUTE=no_bell                       # anyone's reaction that stops it in a thread (inbox: touch inbox/<id>.no_bell)

# What it works on.
TARGET_REPO=../weather-api
ALLOW_PR=false                     # fix_pr only if true AND the script sees red on base, green on head
ALLOW_PUSH=false                   # git push of agent/<id> + `gh pr create`: only if true (and ALLOW_PR=true)

# Models and money. Workshop defaults: Sonnet, $1 a message. The showcase uses more (showcase/owner.env.example).
WATCH_MODEL=haiku                  # the slack watcher tick (inbox lane uses no model to watch)
WORK_MODEL=sonnet                  # triage and act
TRIAGE_MODEL=                      # empty = WORK_MODEL
WORK_BUDGET_USD=1                  # per message: triage + act + retries + post and reaction runs
THREAD_BUDGET_USD=3                # per thread, over every message in it
MAX_WORKERS=2                      # workers at once; more hits wait for the next tick
WATCH_BUDGET_USD=0.05              # per slack tick
POST_BUDGET_USD=0.50               # per Slack post or reaction run

# Slack connector tool names (checked on the real connector, 5-6 Oct).
SLACK_SEARCH_TOOL=mcp__claude_ai_Slack__slack_search_public   # self-DM switches to ..._search_public_and_private
SLACK_SEND_TOOL=mcp__claude_ai_Slack__slack_send_message
SLACK_REACTIONS_TOOL=mcp__claude_ai_Slack__slack_get_reactions
SLACK_ADD_REACTION_TOOL=mcp__claude_ai_Slack__slack_add_reaction
SLACK_READ_THREAD_TOOL=mcp__claude_ai_Slack__slack_read_thread

# Optional (the showcase uses these).
EXTRA_ROUTES=                      # e.g. "duplicate needs_info"
EXTRA_PROMPTS_DIR=                 # where act-<route>.md and routes.md for the extra routes live
MEMORY_FILE=                       # JSONL thread memory, read by triage, appended after each thread
RECEPTION_DIR=                     # where inbox/ outbox/ state/ log/ bot-settings.json live. Empty = the kit folder
