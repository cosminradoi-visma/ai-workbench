{
  "type": "object",
  "properties": {
    "route": { "type": "string", "enum": ["answer", "investigate", "fix_pr", "decline", "escalate"] },
    "reason": { "type": "string", "maxLength": 200 },
    "confidence": { "type": "string", "enum": ["low", "medium", "high"] },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "kind": { "type": "string", "enum": ["file", "test", "log", "doc", "commit", "general"] },
          "ref": { "type": "string" }
        },
        "required": ["kind", "ref"]
      }
    },
    "draft_reply": { "type": "string", "maxLength": 1200 },
    "failing_test": { "type": ["string", "null"] },
    "open_questions": { "type": "array", "items": { "type": "string" } }
  },
  "required": ["route", "reason", "confidence", "evidence", "draft_reply", "failing_test", "open_questions"]
}
