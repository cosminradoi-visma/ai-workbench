# Bogdan's showcase bot. Copy to owner.env, then run ../kit/find-self-dm.sh with OWNER_ENV=$PWD/owner.env:
# it fills OWNER_ID, CHANNEL_ID (your DM with yourself) and MCP_DENY. Placeholders only in this file.
OWNER_ID=U_YOUR_MEMBER_ID
OWNER_NAME=Bogdan
SIGNATURE="🤖 Bogdan's agent:"
SELF_DM=true
SOURCE=slack                       # inbox = rehearse without Slack (drop messages/*.md into inbox/)
CHANNEL_ID=D_YOUR_SELF_DM
TRIGGER=robot_face
MUTE=no_bell
TARGET_REPO=../weather-api
WORKBENCH_DIR=workbench-demo       # or your real ~/workbench
WORK_ITEM=w3
ALLOW_PR=false                     # true only for the rehearsed fix demo (bug 03)
ALLOW_PUSH=false                   # no remote in the demo: the PR body stays in outbox/
WATCH_MODEL=haiku
WORK_MODEL=opus
TRIAGE_MODEL=sonnet
WORK_BUDGET_USD=3
THREAD_BUDGET_USD=8
MAX_WORKERS=2
WATCH_BUDGET_USD=0.60
POST_BUDGET_USD=0.50
MCP_DENY=
SLACK_SEARCH_TOOL=mcp__claude_ai_Slack__slack_search_public_and_private
SLACK_SEND_TOOL=mcp__claude_ai_Slack__slack_send_message
SLACK_REACTIONS_TOOL=mcp__claude_ai_Slack__slack_get_reactions
SLACK_ADD_REACTION_TOOL=mcp__claude_ai_Slack__slack_add_reaction
SLACK_READ_THREAD_TOOL=mcp__claude_ai_Slack__slack_read_thread
EXTRA_ROUTES="duplicate needs_info"
EXTRA_PROMPTS_DIR=prompts
MEMORY_FILE=memory/threads.jsonl
RECEPTION_DIR=.
