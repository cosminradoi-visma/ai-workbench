# Hooks and scripts must keep LF line endings, even on Windows checkouts,
# or `sh` fails on the carriage returns and the guards silently stop running.
* text=auto
*.sh text eol=lf
*.py text eol=lf
*.pl text eol=lf
py text eol=lf
*.json text eol=lf
*.md text eol=lf
*.example text eol=lf
*.env text eol=lf
kb text eol=lf
